{
  "name": "szmap",
  "version": "0.8.0",
  "description": "Analyze codebases and visualize file metrics from the terminal",
  "author": "Jonathan Alarcón <jonathanalarcon144@gmail.com>",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "cli",
    "typescript",
    "code-analysis",
    "metrics",
    "ast",
    "oxc",
    "file-tree",
    "codebase"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathanalarcon14/szmap.git"
  },
  "homepage": "https://github.com/jonathanalarcon14/szmap#readme",
  "bugs": {
    "url": "https://github.com/jonathanalarcon14/szmap/issues"
  },
  "bin": {
    "szmap": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:e2e": "npm run build && NODE_OPTIONS=--experimental-vm-modules jest --testRegex='.*\\.e2e\\.test\\.ts$'",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.18.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.4.2",
    "ts-jest": "^29.4.11",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "jest": {
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*(?<!\\.e2e)\\.test\\.ts$",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@config$": "<rootDir>/src/commands/config/index.ts",
      "^@/(.*)\\.js$": "<rootDir>/src/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "dependencies": {
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "jsonc-parser": "^3.3.1",
    "oxc-parser": "0.147.0",
    "tinyglobby": "^0.2.17",
    "tinypool": "^2.1.2",
    "valibot": "^1.4.2"
  }
}
